# Copy to .env and fill in. .env is git-ignored.
#
# Create a bot with @BotFather -> get the token.
# Add the bot to your channel as an admin, then set TELEGRAM_CHAT_ID to the
# channel id (e.g. @my_channel for a public channel, or -100xxxxxxxxxx for a
# private channel — use @RawDataBot or getUpdates to find the numeric id).
TELEGRAM_BOT_TOKEN=<from @BotFather, e.g. 123456789:AA...>
TELEGRAM_CHAT_ID=<@my_channel or -100xxxxxxxxxx>

# Optional: where the SQLite db lives. Defaults to ./price_tracker.db next to
# the code. Set this to a mounted-volume path (e.g. /data/price_tracker.db on
# Railway) so the corpus survives redeploys. The parent dir is created if needed.
# DB_PATH=/data/price_tracker.db
